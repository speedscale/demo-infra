{
  "id": "banking-cloud-load-fraud-spike",
  "generator": {
    "dlpConfigId": "banking-app-keys",
    "evaluationIntervals": 5,
    "lowDataMode": true,
    "stages": [
      {
        "duration": "30s",
        "virtualUsers": {
          "virtualUsers": "2",
          "requestDelay": {}
        }
      },
      {
        "duration": "30s",
        "virtualUsers": {
          "virtualUsers": "20",
          "requestDelay": {}
        },
        "rampFor": "5s"
      },
      {
        "duration": "60s",
        "virtualUsers": {
          "virtualUsers": "2",
          "requestDelay": {}
        }
      }
    ]
  },
  "rules": [
    {
      "metricName": "p95Latency",
      "type": "TOO_HIGH",
      "value": 500,
      "action": "ALERT"
    },
    {
      "metricName": "failTransactionCount",
      "type": "TOO_HIGH",
      "value": 0,
      "action": "ALERT"
    },
    {
      "metricName": "totalTransactionCount",
      "type": "TOO_LOW",
      "value": 1,
      "action": "ALERT"
    }
  ],
  "version": 3,
  "assertionGroups": [],
  "responder": {
    "numReplicas": 1,
    "responseDelay": {
      "mode": "NONE"
    },
    "dlpConfigId": "banking-app-keys",
    "lowDataMode": true
  },
  "cluster": {
    "cleanup": "inventory",
    "replayMode": "full-replay",
    "sidecarTlsOut": true,
    "logLevel": "info",
    "logsCollected": true,
    "generatorResources": {
      "limits": {
        "cpu": "1",
        "memory": "2147483648"
      },
      "requests": {
        "cpu": "100m",
        "memory": "134217728"
      }
    },
    "responderResources": {
      "limits": {
        "cpu": "500m",
        "memory": "1073741824"
      },
      "requests": {
        "cpu": "100m",
        "memory": "134217728"
      }
    }
  }
}
